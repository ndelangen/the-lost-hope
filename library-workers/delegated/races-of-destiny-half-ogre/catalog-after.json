      "sections": [
        {
          "title": "Species traits",
          "lines": [
            "Large Giant with +6 Strength, −2 Dexterity, +2 Constitution, −2 Intelligence, and −2 Charisma.",
            "Base land speed 30 ft. Darkvision reaches 60 ft. and sees in black and white. +4 natural armor.",
            "The Giant type supplies low-light vision and simple and martial weapon proficiency.",
            "Large size gives −1 to AC and attacks. A Half-Ogre occupies a 10-ft. space and has 10-ft. natural reach.",
            "Common and Giant are automatic. Bonus languages are Abyssal, Draconic, Gnoll, Goblin, and Orc.",
            "Favored class Barbarian. Level adjustment +2. The playable entry grants no racial Hit Dice. One class level is effective character level 3."
          ]
        },
        {
          "title": "Original NPC · Bram Reedbar",
          "lines": [
            "Levee gatekeeper and Fighter.",
            "Motive. Close the levee gate before water reaches the roof of the keeper’s hut, with the repair crew still out in the channel.",
            "Hook. Bring the repair crew to higher ground and Bram will lend the key to the old inspection stair.",
            "Half-Ogre levee gatekeeper, Fighter 1 · Provisional CR 2. ECL 3. · Large Giant",
            "AC 18 · HP 13 (1d10+3) · Speed 30 ft."
          ]
        },
        {
          "title": "Original NPC · Dessa Tallowbeat",
          "lines": [
            "Ridge drummer and Barbarian.",
            "Motive. Find the lookout who missed the final drum call in a whiteout.",
            "Hook. Dessa can call along the route while the party checks the downhill forks for the missing lookout.",
