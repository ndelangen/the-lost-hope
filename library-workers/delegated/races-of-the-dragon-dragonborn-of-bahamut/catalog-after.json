    "version": {
      "key": "c28871ac424fca3730fc6058",
      "publication": "Races of the Dragon (2006)",
      "edition": "3.5 edition",
      "source": "https://www.drivethrurpg.com/en/product/28750/races-of-the-dragon-3-5",
