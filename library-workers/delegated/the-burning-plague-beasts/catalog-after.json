      "sections": [
        {
          "title": "Habitats",
          "lines": [
            "Mines of Duvik’s Pass"
          ]
        },
        {
          "title": "Appearance",
          "lines": [
            "A five-foot-long dire weasel."
          ]
        },
        {
          "title": "Senses",
          "lines": [
            "Scent"
          ]
        },
        {
          "title": "Skills",
          "lines": [
            "Hide +9",
            "Move Silently +10",
            "Spot +5"
          ]
        },
        {
          "title": "Attacks",
          "lines": [
            "Bite · melee · +7 to hit · 1d6+3"
          ]
        },
        {
          "title": "Special attacks and qualities mechanics",
          "lines": [
            "Attach · On a successful bite, the dire weasel latches onto the target. It loses its Dexterity bonus to Armor Class while attached, leaving it at AC 12.",
            "Blood drain · The dire weasel deals 2d4 temporary Constitution damage each round it remains attached."
          ]
        },
        {
          "title": "Encounters mechanics",
          "lines": [
            "Southwestern sacks · The dire weasel hides in the southwestern sack pile. After two rounds it attacks the nearest character on round three. A character spots it by winning an opposed Spot check against its Hide roll. It leaves its kobold handlers alone.",
            "Contagious in this adventure · A creature that comes into contact with this animal must make a DC 13 Fortitude save against the Burning Plague. See the adventure’s disease rules on pp. 3–4."
          ]
        },
        {
          "title": "Table notes",
          "lines": [
            "Neutral. Weapon Finesse (bite).",
            "The encounter prints HD 3d8+0 and Constitution 6.",
            "Miguel Duran, The Burning Plague (Wizards of the Coast, 2000), Area 4: The Larder, pp. 7–8."
          ]
        }
      ],
