    "version": {
      "key": "1bee294d79af7ed34797d712",
      "publication": "Stormwrack (2005)",
      "edition": "3.5 edition",
      "source": "https://books.google.com/books/about/Stormwrack.html?id=ENyiPwAACAAJ",
      "status": "Traits summary",
      "images": [],
      "stats": [
        [
          "Type",
          "Humanoid (Hadozee)"
        ]
      ],
      "sections": [
        {
          "title": "Species traits",
          "lines": [
            "Medium Humanoid (Hadozee). +2 Dexterity, −2 Charisma. Land speed 30 ft. LA +0 and advancement by character class.",
            "Gliding. While using its membranes to glide, a Hadozee takes no damage from a fall of any height. It can travel 20 ft. horizontally for each 5 ft. descended, with glide speed 40 ft. and average maneuverability in the p. 41 player rules. Gliding requires descent.",
            "Hadozee have +4 racial bonuses on Balance and Climb. They keep their Dexterity bonus to AC while climbing and can climb with one hand occupied.",
            "Common and Hadozee are automatic. Aquan, Elven, and Halfling are bonus languages. Favored class Rogue.",
            "Pages 151–152 give the separate encounter entries and repeat the glide at poor maneuverability. Page 152 also lists Dodge and Profession (sailor) as a class skill. The p. 41 player entry gives average maneuverability and omits those benefits. These builds use the player entry."
          ]
        },
        {
          "title": "Original NPC · Renn Farwake",
          "lines": [
            "Rigging scout and Rogue.",
            "Motive. Find the release catch before the broken landing gives way.",
            "Hook. Renn can carry the signal line up to the catwalk.",
            "Hadozee rigging scout, Rogue 1 · Provisional CR 1. ECL 1 (1 class HD, LA +0). · Medium Humanoid (Hadozee)",
            "AC 15 · HP 8 (1d6+2) · Speed 30 ft., glide 40 ft. (average)"
          ]
        },
        {
          "title": "Original NPC · Daro Brightkeel",
          "lines": [
            "Gantry guard and Fighter.",
            "Motive. Reach the winch and bring the deck crew to safety.",
            "Hook. Daro can reach the platform from the gantry after the lower stairs collapse.",
            "Hadozee gantry guard, Fighter 1 · Provisional CR 1. ECL 1 (1 class HD, LA +0). · Medium Humanoid (Hadozee)",
            "AC 14 · HP 12 (1d10+2) · Speed 30 ft., glide 40 ft. (average)"
          ]
        }
      ],
