      "sections": [
        {
          "title": "Species traits",
          "lines": [
            "Medium deep orc (Humanoid). +6 Strength, −2 Dexterity, −2 Wisdom, +2 Charisma. Land speed 30 ft. Darkvision 120 ft. and +2 natural armor.",
            "Light Blindness (Ex). Abrupt bright light, such as sunlight or a daylight spell, blinds an orog for 1 round. Take a −1 circumstance penalty on attack rolls, saves, and checks while in bright light.",
            "Fire resistance 5 and cold resistance 5.",
            "+2 racial bonus on Craft (armorsmithing) and Craft (weaponsmithing) checks.",
            "Racial proficiency with the greatsword and throwing axe.",
            "Orc Blood. An orog counts as an orc for racial effects, including the use or creation of magic items with orc-specific powers.",
            "Orc and Undercommon are automatic. Bonus languages are Common, Dwarven, Elven, Goblin, and Giant.",
            "Class Hit Dice only, LA +2, favored class Fighter. One class level puts a starting orog at ECL 3.",
            "Underdark supplies the 3.5 advancement entry and refers to Races of Faerûn, pp. 71–73, for the detailed racial traits."
          ]
        },
        {
          "title": "Original NPC · Gorvak Ironcleft",
          "lines": [
            "Forge guard and Fighter.",
            "Motive. Keep the forge passage clear until the smiths reach shelter.",
            "Hook. Gorvak is holding the landing below a shuttered light shaft.",
            "Orog forge guard, Fighter 1 · Provisional CR 2. ECL 3 (1 class HD, LA +2). · Medium Humanoid (Orc)",
            "AC 19 · HP 12 (1d10+2) · Speed 20 ft. in half-plate; base 30 ft."
          ]
        },
        {
          "title": "Original NPC · Maig Forgechant",
          "lines": [
            "Foundry caller and Bard.",
            "Motive. Get the workers out before the foundry gates close.",
            "Hook. Maig uses a drum signal to group workers at the side exit.",
            "Orog foundry caller, Bard 1 · Provisional CR 2. ECL 3 (1 class HD, LA +2). · Medium Humanoid (Orc)",
            "AC 15 · HP 8 (1d6+2) · Speed 30 ft."
          ]
        }
