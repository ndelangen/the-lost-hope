      "sections": [
        {
          "title": "Habitats",
          "lines": [
            "Arctic",
            "Underwater"
          ]
        },
        {
          "title": "Appearance",
          "lines": [
            "An enormous eel-like serpent with blue-green scales, a white belly, sail-like dorsal fins, a bony head ridge and four fangs."
          ]
        },
        {
          "title": "Attacks",
          "lines": [
            "Bite · melee · +8 to hit · reach 10 ft. · 3d8 + 6 piercing"
          ]
        },
        {
          "title": "Trait mechanics",
          "lines": [
            "Constrictor · After a Bite hit, it can use Constrict as a bonus action."
          ]
        },
        {
          "title": "Action mechanics",
          "lines": [
            "Constrict · One visible Huge or smaller creature within 10 ft. makes a DC 14 STR save. On a failure it takes 10 (4d4) bludgeoning damage and is grappled. The escape DC is 16."
          ]
        },
        {
          "title": "Table notes",
          "lines": [
