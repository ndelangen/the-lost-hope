        {
          "title": "Appearance",
          "lines": [
            "A stout, semiaquatic rodent large enough to ride, with a thick furry tail that helps it swim and balance."
          ]
        },
        {
          "title": "Skills",
          "lines": [
            "Perception +2"
          ]
        },
        {
