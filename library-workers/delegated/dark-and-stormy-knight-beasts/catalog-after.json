      "sections": [
        {
          "title": "Habitats",
          "lines": [
            "Hightower tomb corridor"
          ]
        },
        {
          "title": "Appearance",
          "lines": [
            "A medium-sized web-spinning spider hidden among silk in the tor."
          ]
        },
        {
          "title": "Senses",
          "lines": [
            "Darkvision 60 ft.",
            "Tremorsense 60 ft."
          ]
        },
        {
