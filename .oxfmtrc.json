{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortImports": true,
  "sortTailwindcss": true,
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "src/routeTree.gen.ts",
    "src/icon-catalog/catalog.json",
    "src/icon-catalog/upstream/*.json",
    "bun.lock"
  ]
}
