{
  "name": "dag",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun scripts/generate-social-images.tsx --dev && vite dev --port 3000",
    "build": "bun run generate:social-images && vite build && bun run audit:public-build",
    "preview": "vite preview",
    "prototype:minimal-js": "bun scripts/prototype-minimal-js.ts",
    "test": "bun run generate:social-paths && vitest run",
    "test:watch": "bun run generate:social-paths && vitest",
    "fetch:icon-metadata": "bun scripts/fetch-icon-metadata.ts",
    "generate:icons": "bun scripts/generate-icon-catalog.ts",
    "generate:icons:check": "bun scripts/generate-icon-catalog.ts --check",
    "icons:classify": "bun scripts/classify-icons.ts",
    "icons:search": "bun scripts/search-icons.ts",
    "generate:refs": "bun scripts/generate-refs.ts",
    "generate:refs:check": "bun scripts/generate-refs.ts --check",
    "generate:social-images": "bun scripts/generate-social-images.tsx",
    "generate:social-paths": "bun scripts/generate-social-images.tsx --paths-only",
    "audit:public-build": "bun scripts/audit-public-build.ts",
    "typecheck": "bun run generate:social-paths && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run generate:refs:check && bun run generate:icons:check && bun run typecheck && bun run lint && bun run fmt:check",
    "verify": "bun run generate:social-images && bun run check && bun run test && vite build && bun run audit:public-build"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-router": "1.170.25",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-start": "1.168.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "octokit": "^5.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "5.15.4",
    "@iconify-json/game-icons": "1.2.4",
    "@netlify/functions": "^5.3.0",
    "@netlify/vite-plugin-tanstack-start": "1.3.17",
    "@resvg/resvg-js": "2.6.2",
    "@tanstack/devtools-vite": "^0.3.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "satori": "0.29.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5"
  }
}
